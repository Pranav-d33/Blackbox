# Blackbox configuration. Copy to .env and fill the values marked  <-- SET ME.
# Shared by core/ (TypeScript) and robot/ (Python). Never commit .env.

# ---------------------------------------------------------------- 0G Chain
# galileo (testnet, chain 16602) | mainnet (16661) | local (anvil) | none
CHAIN=galileo
# RPC_URL=                      # optional override (docs: use a 3rd-party RPC for production)
BLACKBOX_REGISTRY=              # <-- SET ME: from contracts/deployments/16602.json after `forge script` (README step 3)
# zerobot's RobotRegistry proxy on Galileo (from github.com/0gfoundation/zerobot). On mainnet: your SimpleRobotRegistry.
ROBOT_REGISTRY=0x291162e93D7A80Eb8F738882a28a7a8A5FBA73bb
ROBOT_ID=                       # <-- SET ME: printed by `npm run setup:robot`
ROBOT_NAME=blackbox-drone-1     # robot id = keccak256(ROBOT_NAME) unless ROBOT_ID is set

# Wallets (`npm run keys` makes fresh ones)
OPERATOR_PRIVATE_KEY=           # <-- SET ME: funded on Galileo (faucet.0g.ai). Pays Storage fees + registry gas, owns the zerobot robot.
ROBOT_PRIVATE_KEY=              # <-- SET ME: the robot's own key. Lives only in the robot adapter. Needs no funds.
ROBOT_TEE_SIGNERS_FROM=chain    # chain: the robot checks every allowlisted TEE signer on 0G's InferenceServing itself
                                # pinned: only the signers in ROBOT_TEE_SIGNERS; off: trust the core (mock only)
ROBOT_TEE_SIGNERS=              # comma-separated, for pinned mode
DEPLOYER_PRIVATE_KEY=           # used by contracts/script/Deploy.s.sol (can equal OPERATOR_PRIVATE_KEY)

# -------------------------------------------------------------- 0G Storage
STORAGE=0g                      # 0g | local (dev only)
# STORAGE_NETWORK=galileo       # defaults to the chain's network
# STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
STORAGE_WAIT_FINALITY=false     # true = wait for storage-node finality on every upload (slower)
STORE_CROPS=true                # also upload each checkpoint's camera crop
CROP_PRIVACY=encrypted          # encrypted (AES-256-GCM, per-mission key, docs/privacy.md) | public (plain PNG)
# CROP_KEY=                     # 32-byte hex master key; default: generated once in core/data/crop.key, never uploaded

# -------------------------------------------------------------- 0G Compute
ZG_MODE=router                  # router (real 0G) | mock (dev only, never a fallback)
ZG_API_KEY=                     # <-- SET ME: sk-... from https://pc.0g.ai (small mainnet deposit)
# Comma list name=url. Second endpoint = failover (R17). Testnet Router URL: confirm at the 0G booth.
ZG_ROUTER_ENDPOINTS=mainnet=https://router-api.0g.ai/v1
ZG_VISION_MODEL=0gm-1.0-35b-a3b # sealed TeeML vision model (0G's own). Fallback: qwen3-vl-plus (TeeTLS -> say "route-attested")
ZG_TRUST_MODE=private           # X-0G-Provider-Trust-Mode: private = TeeML providers only
ZG_ATTESTATION=tee              # tee (default) | none = UNSEALED fallback for a model with no TEE provider. Needs ZG_TRUST_MODE=standard and a Standard-trust key. The manifest, console and verifier all say "unsealed".
# Extra request body fields, merged into every vision call (null deletes a default field).
ZG_VISION_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Where TEE signer addresses come from: 0G Compute InferenceServing on mainnet
ZG_SERVING_RPC=https://evmrpc.0g.ai
ZG_SERVING_CONTRACT=0x47340d900bdFec2BD393c626E12ea0656F938d84
# TEE_SIGNER_ALLOWLIST=         # extra signers (comma list). Normally read from the chain service records.
ZG_DECISION_MODEL=              # R16 calibrated hold: laya | vela-2.0-9b (mainnet). Empty = off.
DECISION_HOLD_BELOW=600         # hold and ask a human below this confidence (per mille)
HOLD_ON_UNSURE=                 # 1 = hold and ask the crew (text or voice) when 0G's vision answer is "unsure". No reply = safe-stop

# ----------------------------------------------------------------- Arkiv
# Arkiv (Rabdi testnet, chain 7794095): queryable findings, the site's asset register, the fleet board,
# and a mirror of every 0G Storage blob the verifier can fall back to. 0G stays the permanent proof.
ARKIV=none                      # rabdi | none
# ARKIV_PRIVATE_KEY=            # the inspector's Arkiv wallet (writes findings). Defaults to OPERATOR_PRIVATE_KEY. Fund it: https://hub.arkiv.network/faucet
# ARKIV_OWNER_PRIVATE_KEY=      # the site owner's wallet (owns the asset register). `npm run arkiv:register` makes and funds one if unset
# ARKIV_ACCESS_KEY=             # optional, free at https://hub.arkiv.network/access-keys (the public endpoint is heavily rate limited)
# ARKIV_RETENTION_DAYS=90       # how long findings and mirrors stay queryable (Rabdi max ~91; 0G keeps the proof forever)
# ARKIV_MIRROR=true             # mirror every 0G Storage blob (manifest, entries, index) as the verifier's fallback

# ------------------------------------------------------------------ policy
LEASE_MS=12000                  # safe-stop lease: 3x Gate A median latency, capped at 12000 (`npm run probe` prints it)
TEE_BINDING=auto                # auto | go | raw - set to what `npm run probe` reports
NONCE_HEX_LEN=64                # nonce chars the model must echo (lower only if Gate A echo rate is poor)
ANCHOR_EVERY=2                  # anchor the chain head every N decisions
MAX_ASKS=2                      # ask 0G again once inside the lease on a bad answer

# ------------------------------------------------------------- processes
CORE_PORT=8787
ROBOT_URL=http://127.0.0.1:8801
CORE_URL=http://127.0.0.1:8787
SIM_BACKEND=auto                # auto (mujoco > pybullet > native) | mujoco | pybullet | native
SCENARIO=solar-farm             # default mission profile: a file in scenarios/ (solar-farm | bridge-deck)
SIM_SPEED=1.0
ROBOT_DRIVER=sim                # sim | rover (Raspberry Pi, see robot/blackbox_robot/rover.py)
PUBLIC_VERIFIER_URL=            # <-- SET ME for the QR code: your deployed verify page, e.g. https://blackbox-verify.vercel.app/verify.html
# BLACKBOX_TEXTURE_DIR=         # real crack/decoy photos: <dir>/crack/*.png, <dir>/decoy/*.png

# ----------------------------------------------------------- hosted / public (Docker, Railway, Render)
# PUBLIC_MODE=1                 # guardrails for an instance on the open internet (core/src/guard.ts). Off for local demos
# ADMIN_TOKEN=                  # <-- SET ME: send as header x-admin-token to bypass every public-mode limit (use a long random string)
# PUBLIC_DAILY_FLIGHTS=40       # flights a day across all visitors; each one spends 0G credits and chain gas
# PUBLIC_FLIGHT_COOLDOWN_S=90   # per visitor IP between two flights
# PUBLIC_MAX_MARKS=8            # marks one flight may carry
