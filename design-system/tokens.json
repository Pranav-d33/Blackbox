{
  "meta": {
    "name": "Blackbox Design System",
    "version": "2.0.0",
    "source": "CHARAK Design System · V2 structure, Apple system colour scheme",
    "principle": "Proof that reads at a glance. Blue acts, Flame flags.",
    "note": "Single source of truth for Blackbox surfaces (Launch Showroom, Operator Console, Public Verifier)."
  },

  "color": {
    "ramp": {
      "blue": {
        "role": "Primary · trust, every action (Apple systemBlue)",
        "brand": "500",
        "50": "#EAF4FF", "100": "#D6EAFF", "200": "#ADDBFF", "300": "#66B5FF", "400": "#2997FF",
        "500": "#0071E3", "600": "#0066CC", "700": "#004E9E", "800": "#00356B", "900": "#001C3D"
      },
      "flame": {
        "role": "Warmth & telemetry · flagged defects, eyebrows (Apple systemOrange)",
        "brand": "500",
        "50": "#FFF4E8", "100": "#FFE5CA", "200": "#FFC894", "300": "#FFA85E", "400": "#FF8A3D",
        "500": "#FF9500", "600": "#BF4800", "700": "#8F3600", "800": "#5E2300", "900": "#331200"
      },
      "emerald": {
        "role": "Verified & sealed · TEE proof, chain anchors (Apple systemGreen)",
        "brand": "500",
        "50": "#EBF9EE", "100": "#CEF0D6", "200": "#9CE0AD", "300": "#65D181", "400": "#32D74B",
        "500": "#34C759", "600": "#1D8A3A", "700": "#15682B", "800": "#0E461D", "900": "#072610"
      },
      "graphite": {
        "role": "Text, chrome, operator console & verifier (Apple systemGray)",
        "brand": "900",
        "50": "#F5F5F7", "100": "#E8E8ED", "200": "#D2D2D7", "300": "#A1A1A6", "400": "#86868B",
        "500": "#6E6E73", "600": "#424245", "700": "#2C2C2E", "800": "#1D1D1F", "900": "#000000"
      }
    },

    "status": {
      "flagged":  { "label": "Flagged · Holding",   "solid": "#FF9500" },
      "acting":   { "label": "0G Signed · Acting",  "solid": "#0071E3" },
      "verified": { "label": "Verified · Anchored", "solid": "#34C759" },
      "sealed":   { "label": "Sealed TEE · Hold",   "solid": "#A78BFA" },
      "waiting":  { "label": "Lease active",        "solid": "#FFD60A" },
      "refused":  { "label": "Refused · Safe stop", "solid": "#FF453A" }
    },

    "scheme": {
      "showroom": {
        "brightness": "light",
        "ground":      "#F5F5F7",
        "card":        "#FFFFFF",
        "tint":        "#EAF4FF",
        "warm":        "#FFF4E8",
        "fill":        "#E8E8ED",
        "text":        "#1D1D1F",
        "textMuted":   "#6E6E73",
        "textFaint":   "#86868B",
        "line":        "#D2D2D7",
        "lineStrong":  "#A1A1A6",
        "primary":     "#0071E3",
        "onPrimary":   "#FFFFFF",
        "primaryPressed": "#0066CC",
        "primarySoft": "#EAF4FF",
        "primaryMid":  "#D6EAFF",
        "onPrimarySoft": "#004E9E",
        "accentWarm":  "#BF4800",
        "accentWarmSoft": "#FFE5CA",
        "onAccentWarmSoft": "#8F3600",
        "greeting":    "#BF4800",
        "success":     "#1D8A3A",
        "warning":     "#FF9500",
        "danger":      "#D70015",
        "dangerSoft":  "#FFE5E3",
        "onDangerSoft": "#A1121A",
        "chrome":      "#1D1D1F",
        "onChrome":    "#FFFFFF",
        "scrim":       "#00000073",
        "status": {
          "flagged":  { "soft": "#FFE5CA", "on": "#8F3600" },
          "acting":   { "soft": "#D6EAFF", "on": "#004E9E" },
          "verified": { "soft": "#CEF0D6", "on": "#15682B" },
          "sealed":   { "soft": "#EFEAFB", "on": "#5835B0" },
          "waiting":  { "soft": "#FFF6CC", "on": "#7A5E00" },
          "refused":  { "soft": "#FFE5E3", "on": "#A1121A" },
          "neutral":  { "soft": "#E8E8ED", "on": "#424245" }
        }
      },
      "console": {
        "brightness": "dark",
        "ground":      "#000000",
        "card":        "#1D1D1F",
        "tint":        "#001C3D",
        "warm":        "#331200",
        "fill":        "#2C2C2E",
        "text":        "#F5F5F7",
        "textMuted":   "#A1A1A6",
        "textFaint":   "#86868B",
        "line":        "#2C2C2E",
        "lineStrong":  "#424245",
        "primary":     "#0071E3",
        "onPrimary":   "#FFFFFF",
        "primaryPressed": "#0077ED",
        "primarySoft": "#001C3D",
        "primaryMid":  "#00356B",
        "onPrimarySoft": "#66B5FF",
        "accentWarm":  "#FF8A3D",
        "accentWarmSoft": "#331200",
        "onAccentWarmSoft": "#FFC894",
        "greeting":    "#FF8A3D",
        "success":     "#32D74B",
        "warning":     "#FFD60A",
        "danger":      "#FF453A",
        "dangerSoft":  "#3A1618",
        "onDangerSoft": "#FF8A80",
        "chrome":      "#000000",
        "onChrome":    "#F5F5F7",
        "scrim":       "#000000B8",
        "status": {
          "flagged":  { "soft": "#331200", "on": "#FFC894" },
          "acting":   { "soft": "#001C3D", "on": "#66B5FF" },
          "verified": { "soft": "#072610", "on": "#9CE0AD" },
          "sealed":   { "soft": "#241A3E", "on": "#CDB6FF" },
          "waiting":  { "soft": "#332900", "on": "#FFE366" },
          "refused":  { "soft": "#3A1618", "on": "#FF8A80" },
          "neutral":  { "soft": "#2C2C2E", "on": "#D2D2D7" }
        }
      }
    },

    "mix": {
      "note": "Share of a typical surface. Keep Apple Blue to ~10% so it keeps meaning 'tap here'.",
      "ground": 58, "card": 24, "blue": 10, "flameEmerald": 5, "status": 3
    }
  },

  "type": {
    "family": "Anek Latin",
    "mono": "IBM Plex Mono",
    "axes": { "wdth": [75, 125], "wght": [100, 800] },
    "rules": [
      "Headers never go below width 118, in sentence case (never all-caps).",
      "Numbers (latencies, altitudes, checkpoints, fees, countdowns) always use tabular figures and narrow width 80.",
      "Hashes, signers, nonces and JSON payloads use IBM Plex Mono."
    ],
    "style": {
      "display":     { "size": 56, "line": 60, "weight": 750, "width": 125 },
      "titleLarge":  { "size": 36, "line": 42, "weight": 700, "width": 122 },
      "titleMedium": { "size": 26, "line": 32, "weight": 650, "width": 118 },
      "titleSmall":  { "size": 20, "line": 26, "weight": 650, "width": 112 },
      "bodyLarge":   { "size": 18, "line": 26, "weight": 400, "width": 100 },
      "body":        { "size": 16, "line": 24, "weight": 400, "width": 100 },
      "label":       { "size": 15, "line": 20, "weight": 600, "width": 105 },
      "caption":     { "size": 13, "line": 18, "weight": 500, "width": 100 },
      "overline":    { "size": 12, "line": 16, "weight": 700, "width": 110, "tracking": 1.2, "uppercase": true },
      "numeric":     { "size": 20, "line": 24, "weight": 600, "width": 80, "tabular": true }
    }
  },

  "radius": {
    "pill": 999,
    "sheet": 32,
    "card": 26,
    "tile": 20,
    "field": 20,
    "avatar": 16,
    "check": 8
  },

  "size": {
    "buttonMinHeight": 52,
    "buttonCompact": 44,
    "chipHeight": 40,
    "touchMin": 44,
    "checkBox": 24,
    "bottomBarHeight": 68,
    "navPillWidth": 56,
    "navPillHeight": 32,
    "nowBarHeight": 60
  },

  "space": {
    "xs": 4, "sm": 8, "md": 12, "base": 16, "gutter": 20, "lg": 24, "xl": 32, "xxl": 48
  },

  "motion": {
    "pressScale": 0.96,
    "liftOffset": 20,
    "maxDuration": 450,
    "token": {
      "press":      { "ms": 150,  "curve": [0.22, 1, 0.36, 1], "use": "Buttons, tiles, rows · scale 0.96" },
      "standard":   { "ms": 300,  "curve": [0.33, 0, 0.1, 1],  "use": "Tabs, segments, status, colour" },
      "emphasized": { "ms": 450,  "curve": [0.22, 1, 0.36, 1], "use": "Enter, live checkpoint card, modal sheets" },
      "exit":       { "ms": 200,  "curve": [0.4, 0, 1, 1],     "use": "Dismiss, toast out, modal close" },
      "stagger":    { "ms": 40,   "maxItems": 6, "use": "Added per item on screen enter (240ms tail max)" },
      "live":       { "ms": 1600, "use": "Pulse on active checkpoint / live telemetry dot" },
      "reduced":    { "ms": 150,  "use": "Everything becomes a plain fade when Reduce motion is on" }
    }
  }
}
